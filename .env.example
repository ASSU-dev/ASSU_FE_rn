EXPO_PUBLIC_API_BASE_URL=            # 예: https://dev.assu.site
EXPO_PUBLIC_USE_MOCKS=false          # true로 설정하면 모의 응답을 사용합니다.
EXPO_PUBLIC_KAKAO_JS_KEY=            # 카카오 디벨로퍼스 JavaScript 키
EXPO_PUBLIC_SSU_LOGIN_URL=           # 유세인트 SSO 로그인 URL (LMS 인증 WebView)
EXPO_PUBLIC_STOMP_BROKER_URL=        # 예: wss://dev.assu.site/ws
EXPO_PUBLIC_SSU_TEST_SIDNO=          # (선택) 개발 빌드(__DEV__) 전용: 설정 시 WebView 없이 바로 로그인. 프로덕션 빌드에서는 무시됨
EXPO_PUBLIC_SSU_TEST_STOKEN=         # (선택) 개발 빌드(__DEV__) 전용. 실제 계정 토큰을 커밋/공유하지 말 것
